{
  "name": "harbor-overworld",
  "version": "0.1.8",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:presence": "node server/build.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "playground": "vite --mode playground --host 127.0.0.1 --strictPort",
    "control": "node scripts/control.mjs",
    "test:movement": "node --test src/world/movement.test.mjs",
    "test:inventory": "node --test src/blort/inventory/inventory.test.mjs",
    "test:loot": "node --test src/blort/loot/tables.test.mjs",
    "test:inventory-server": "node --test src/blort/server/inventory-room.test.mjs",
    "test:presence": "pnpm run build:presence && node --test server/presence.test.mjs"
  },
  "dependencies": {
    "@polycentric/js-browser": "workspace:*",
    "@polycentric/js-core": "workspace:*",
    "@polycentric/rs-core-wasm": "workspace:*"
  },
  "devDependencies": {
    "@protobuf-ts/grpcweb-transport": "^2.11.1",
    "@types/node": "catalog:",
    "@types/ws": "8.18.1",
    "esbuild": "0.28.2",
    "typescript": "catalog:",
    "vite": "8.3.8",
    "ws": "8.23.0"
  }
}
